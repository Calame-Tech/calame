{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calame",
  "mainBinaryName": "calame-desktop",
  "version": "../package.json",
  "identifier": "tech.calame.desktop",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Calame",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/node"],
    "resources": ["resources/server"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Calame-Tech/calame/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2OERENEM2RkRBQkVCMkMKUldRczY2djl4dFNOeG5HUVkxWW1rM3dyejdpZUtKUjNsRjFIZmU4N0lrR0RpcnZyZElBUHQzRGkK"
    }
  }
}
