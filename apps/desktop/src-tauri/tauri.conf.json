{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calame",
  "mainBinaryName": "calame-desktop",
  "version": "../package.json",
  "identifier": "tech.calame.desktop",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Calame",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/node"],
    "resources": ["resources/server"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
