<?xml version="1.0" encoding="utf-8"?>
<!--
  Calame MSI fragment (bundle.windows.wix.fragmentPaths + componentRefs in tauri.conf.json).

  Optional deletion of the user's Calame data on uninstall, the MSI counterpart of
  ../installer-hooks.nsh. The Calame server keeps its data in %APPDATA%\Calame
  (getPackagedDataDir in packages/cli/src/config.ts): calame.db (+ -wal/-shm) and
  .calame-secret. Tauri's default MSI template (WiX 3, WixUI_InstallDir, perMachine) never
  touches it. This fragment:
    - adds a "Vos données Calame" page to the full-UI Remove path (MaintenanceTypeDlg >
      Remove > this page > VerifyReadyDlg), with an unchecked box; no page exists in the
      basic UI used by "Désinstaller" in Windows Settings, nor in /passive or /quiet runs,
      so these always keep the data;
    - resolves the folder in the UI, which runs as the user who launched the uninstall (not
      as the account entering UAC credentials), and shows it with that account's name;
    - deletes through a deferred custom action impersonating that same user, never during a
      major upgrade (UPGRADINGPRODUCTCODE) and only for a full removal (REMOVE="ALL"); the
      script checks again that the folder is the running account's own %APPDATA%\Calame,
      stops that account's app and Node server, and renames the folder before deleting it
      so that calame.db and .calame-secret go together or not at all.
  The component below installs the script and makes the linker pull this fragment in.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="CalameUninstallDataScript" Guid="*">
        <File Id="CalameUninstallDataScript" Source="$(sys.SOURCEFILEDIR)calame-uninstall-data.ps1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Unchecked by default: no value. Secure so that the choice reaches the elevated server. -->
    <Property Id="CALAME_DELETE_DATA" Secure="yes" />
    <Property Id="CALAME_DATA_DIR" Secure="yes" />
    <!-- Set only when the launching user's data folder exists. -->
    <Property Id="CALAME_DATA_FOUND">
      <DirectorySearch Id="CalameDataDirSearch" Path="[AppDataFolder]Calame" Depth="0" />
    </Property>

    <CustomAction Id="CalameRemoveUserData" Directory="INSTALLDIR" Execute="deferred" Impersonate="yes" Return="ignore" ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#CalameUninstallDataScript]&quot; -InstallDir &quot;[INSTALLDIR].&quot; -DataDir &quot;[CALAME_DATA_DIR]&quot;" />

    <InstallExecuteSequence>
      <Custom Action="CalameRemoveUserData" Before="RemoveFiles">REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE AND CALAME_DELETE_DATA="1" AND CALAME_DATA_DIR</Custom>
    </InstallExecuteSequence>

    <UI>
      <Dialog Id="CalameRemoveDataDlg" Width="370" Height="270" Title="!(loc.MaintenanceTypeDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.MaintenanceTypeDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Vos données Calame" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Conserver (par défaut) ou supprimer vos données." />
        <Control Id="KeepText" Type="Text" X="20" Y="52" Width="330" Height="26" NoPrefix="yes" Text="Par défaut, vos données sont conservées : en réinstallant Calame, vous retrouverez le même compte administrateur et vos contenus." />
        <Control Id="PathText" Type="Text" X="20" Y="80" Width="330" Height="26" NoPrefix="yes" Text="Dossier de données du compte Windows [LogonUser] : [AppDataFolder]Calame" />
        <Control Id="DeleteCheckBox" Type="CheckBox" X="20" Y="110" Width="330" Height="17" Property="CALAME_DELETE_DATA" CheckBoxValue="1" Text="Supprimer aussi mes données Calame (compte et contenus)">
          <Condition Action="disable">NOT CALAME_DATA_FOUND</Condition>
          <Condition Action="enable">CALAME_DATA_FOUND</Condition>
        </Control>
        <Control Id="LostText" Type="Text" X="20" Y="131" Width="330" Height="66" NoPrefix="yes" Text="Si vous cochez, seront supprimés définitivement, pour ce compte Windows uniquement : la base calame.db (comptes, dont l'administrateur, connexions, conversations, réglages) et la clé .calame-secret qui protège les mots de passe enregistrés, ensemble, ainsi que les données techniques de l'application. Après une réinstallation, vous créerez un nouveau compte administrateur. Pour garder une sauvegarde, copiez d'abord ce dossier ailleurs." />
        <Control Id="NotFoundText" Type="Text" X="20" Y="202" Width="330" Height="26" NoPrefix="yes" Hidden="yes" Text="Aucune donnée Calame n'a été trouvée pour ce compte Windows : rien ne sera supprimé. Les données des autres comptes Windows ne sont jamais concernées.">
          <Condition Action="show">NOT CALAME_DATA_FOUND</Condition>
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="CalameRemoveDataDlg" Order="10">1</Publish>
      <Publish Dialog="CalameRemoveDataDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
      <!-- The folder to delete is fixed here, from the UI user's profile; unticked, it is cleared. -->
      <Publish Dialog="CalameRemoveDataDlg" Control="Next" Property="CALAME_DATA_DIR" Value="[AppDataFolder]Calame" Order="1">CALAME_DELETE_DATA="1" AND CALAME_DATA_FOUND</Publish>
      <Publish Dialog="CalameRemoveDataDlg" Control="Next" Property="CALAME_DATA_DIR" Value="{}" Order="2">NOT (CALAME_DELETE_DATA="1" AND CALAME_DATA_FOUND)</Publish>
      <Publish Dialog="CalameRemoveDataDlg" Control="Next" Property="CALAME_DELETE_DATA" Value="{}" Order="3">NOT CALAME_DATA_FOUND</Publish>
      <Publish Dialog="CalameRemoveDataDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="4">1</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="CalameRemoveDataDlg" Order="10">Installed AND NOT PATCH AND WixUI_InstallMode = "Remove"</Publish>
    </UI>
  </Fragment>
</Wix>
